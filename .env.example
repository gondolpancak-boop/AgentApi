# === Hermes Telegram Agent Configuration ===

# [REQUIRED] Telegram Bot Token - dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [REQUIRED] OpenRouter API Key - dapatkan dari https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# [OPTIONAL] Model Hermes yang digunakan (default: gratis)
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# [OPTIONAL] OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# [OPTIONAL] Maksimal riwayat percakapan per chat
MAX_HISTORY=20

# [OPTIONAL] Maksimal token per respons
MAX_TOKENS=2048

# [OPTIONAL] Temperature untuk kreativitas respons (0.0 - 1.0)
TEMPERATURE=0.7
